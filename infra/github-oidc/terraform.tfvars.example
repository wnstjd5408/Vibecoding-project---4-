# terraform.tfvars로 복사해 실제 값을 넣는다. terraform.tfvars는 커밋하지 않는다.

# 이메일 @ 앞부분. infra/terraform.tfvars의 owner와 같은 값.
owner = "OWNER"

# infra/backend.hcl의 bucket과 같은 상태 버킷 이름
state_bucket_name = "STATE-BUCKET-NAME"

# infra/terraform.tfvars의 cloudtrail_bucket_name과 같은 값
cloudtrail_bucket_name = "aws-cloudtrail-logs-ACCOUNTID-XXXXXXXX"

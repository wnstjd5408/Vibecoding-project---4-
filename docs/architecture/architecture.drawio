        <mxCell id="browser" value="&lt;b&gt;브라우저&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;React 화면. Supabase 키·AI 키 없음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="zone-client">
          <mxGeometry x="20" y="50" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="static" value="&lt;b&gt;정적 화면 파일&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;React(Vite) 빌드 결과&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="zone-vercel">
          <mxGeometry x="30" y="30" width="240" height="66" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;FastAPI (/api)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Vercel 함수, 도쿄(hnd1). 비밀값은 환경변수&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="zone-vercel">
          <mxGeometry x="30" y="110" width="240" height="400" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;계정·비밀번호 관리. 세션은 HttpOnly 쿠키&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="zone-supabase">
          <mxGeometry x="30" y="120" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;모든 표 RLS, anon·authenticated 권한 회수. 원자 작업은 SQL 함수(service_role만 EXECUTE)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="zone-supabase">

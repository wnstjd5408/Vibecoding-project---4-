        </mxCell>
        <mxCell id="note_images" value="&lt;b&gt;노트 이미지 버킷&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;비공개. FastAPI가 읽기 권한 확인 뒤 서명 URL 발급&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="zone-supabase">
          <mxGeometry x="30" y="415" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="glossary_images" value="&lt;b&gt;사전 이미지 버킷&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;공개 읽기 제안(Q7 미정). 쓰기는 FastAPI만&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="zone-supabase">
          <mxGeometry x="30" y="315" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Converse API, 모델 gpt-6-luna(잠정). 도구 권한 없음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="zone-external">

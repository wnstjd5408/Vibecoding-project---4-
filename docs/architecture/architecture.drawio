        <mxCell id="zone-client" value="사용자 기기 (신뢰하지 않음)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1">

          <mxGeometry x="960" y="60" width="340" height="540" as="geometry" />
        </mxCell>
        <mxCell id="zone-external" value="외부 AI 서비스" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="zone-onetime" value="Notion 가져오기 (처음 한 번)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">

# 필요한 환경변수 이름 목록이다. 실제 값은 .env에 두고 커밋하지 않는다.
# 로컬 DB와 테스트 계정 설정은 docs/backend-local-guide.md를 따른다.
# 보조 도구가 .local-backend/.env를 만들므로 운영 키를 복사하지 않는다.

# Supabase 프로젝트 URL (https://<project-ref>.supabase.co)
SUPABASE_URL=
# 백엔드 전용 secret key(sb_secret_...). RLS를 우회하므로 프론트엔드·로그·URL에 넣지 않는다.
# 용도별로 키를 따로 만든다(예: backend-local).
SUPABASE_SECRET_KEY=
# 노트 이미지 비공개 버킷 이름. 노트 읽기(E05)가 서명 URL을 발급할 때만 쓴다. 비밀값은 아니다.
NOTE_IMAGE_BUCKET=
# 사전 이미지 공개 읽기 버킷 이름. 사전 읽기(E06)가 공개 주소를 만들고 운영자 사전(E21~E23)이 올리고 지울 때 쓴다.
# 마이그레이션 20261102160000이 만드는 버킷은 glossary-images다. 비밀값은 아니다.
GLOSSARY_IMAGE_BUCKET=

# Notion 가져오기 스크립트 전용. 읽기 전용 통합 토큰이며 "공부 기록" DB만 공유한다.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# AI 호출(Bedrock) 인증. 절차와 규칙은 docs/ai-credentials.md
# 인증 방식: oidc(기본) 또는 api_key. 비워 두면 oidc.
AI_AUTH_MODE=
# oidc 모드: Vercel OIDC로 맡을 IAM 역할 ARN
AWS_ROLE_ARN=
# api_key 모드(대체 경로): Bedrock 장기 API 키. 만료 30일. 값을 화면·로그에 출력하지 않는다.
AWS_BEARER_TOKEN_BEDROCK=
# 선택: 비우면 ap-northeast-1 / global.openai.gpt-6-luna
BEDROCK_REGION=
BEDROCK_MODEL_ID=
# AI 예산·단가(USD). AI를 부를 때 필수이고 없으면 예약 전에 500이다. 금액은 커밋하지 않는다.
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
# 입력·출력 100만 토큰당 단가
AI_INPUT_USD_PER_MTOK=
AI_OUTPUT_USD_PER_MTOK=
# 선택(MEG-282): CS Agent(E29 1차·2차)만 다른 모델로 부를 때. 비우면 BEDROCK_MODEL_ID와 위 단가를 쓴다(지금 동작).
# 단가 두 값은 함께 설정한다. E09 설명·퀴즈·꼬리 질문은 늘 BEDROCK_MODEL_ID와 위 단가다.
BEDROCK_AGENT_MODEL_ID=
AI_AGENT_INPUT_USD_PER_MTOK=
AI_AGENT_OUTPUT_USD_PER_MTOK=

# 상태를 바꾸는 요청(POST·PUT·PATCH·DELETE)을 받을 출처. 쉼표로 구분하며 scheme://host[:port] 형태만 받는다.
# `*`·경로가 든 값은 시작할 때 거부한다. CORS 허용 출처도 같은 값이다.
# 비우면 http://localhost:5173(로컬 개발). 운영(VERCEL_ENV=production)에서는 비우면 앱이 시작하지 않는다.
ALLOWED_ORIGINS=

# CS Agent 노출 중단 플래그(MEG-236). 비우거나 0·false·no·off면 꺼져 있다. 다른 값이면 E27·E29가 503이다.
# 절차는 docs/deployment-guide.md "CS Agent 노출 중단" 절을 따른다.
CS_AGENT_DISABLED=

# CS Agent 위키 플래그(MEG-252). 기본 꺼짐. 1·true·yes·on일 때만 켜진다(그 밖의 값은 꺼짐).
# 켜면 E27 origin wiki를 받고 E29 근거를 위키(사전 항목) 검색으로 찾는다. 켜는 것은 MEG-253에서 사람이 정한다.
# 절차는 docs/deployment-guide.md "CS Agent 위키 플래그" 절을 따른다.
CS_AGENT_WIKI_ENABLED=

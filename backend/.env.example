# 필요한 환경변수 이름 목록이다. 실제 값은 .env에 두고 커밋하지 않는다.

# Supabase 프로젝트 URL (https://<project-ref>.supabase.co)
SUPABASE_URL=
# 백엔드 전용 secret key(sb_secret_...). RLS를 우회하므로 프론트엔드·로그·URL에 넣지 않는다.
# 용도별로 키를 따로 만든다(예: backend-local).
SUPABASE_SECRET_KEY=

# Notion 가져오기 스크립트 전용. 읽기 전용 통합 토큰이며 "공부 기록" DB만 공유한다.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# AI 호출(Bedrock) 인증. 절차와 규칙은 docs/ai-credentials.md
# 인증 방식: oidc(기본) 또는 api_key. 비워 두면 oidc.
AI_AUTH_MODE=
# oidc 모드: Vercel OIDC로 맡을 IAM 역할 ARN
AWS_ROLE_ARN=
# api_key 모드(대체 경로): Bedrock 장기 API 키. 만료 30일. 값을 화면·로그에 출력하지 않는다.
AWS_BEARER_TOKEN_BEDROCK=
# 선택: 비우면 ap-northeast-1 / global.openai.gpt-6-luna
BEDROCK_REGION=
BEDROCK_MODEL_ID=

# 상태를 바꾸는 요청(POST·PUT·PATCH·DELETE)을 받을 출처. 쉼표로 구분한다.
# 비우면 http://localhost:5173(로컬 개발). 운영에서는 앱 주소로 설정한다.
ALLOWED_ORIGINS=
